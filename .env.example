# Browser-safe Supabase configuration. These values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server and worker only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python worker settings use the LAUNCHPAD_ prefix.
LAUNCHPAD_SUPABASE_URL=https://your-project.supabase.co
LAUNCHPAD_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LAUNCHPAD_LOG_LEVEL=INFO
LAUNCHPAD_LOG_FORMAT=console

# Phase 5 email delivery. Use a verified sender/domain from your Resend account.
LAUNCHPAD_RESEND_API_KEY=your-resend-api-key
LAUNCHPAD_EMAIL_FROM=Launchpad <alerts@your-domain.example>
LAUNCHPAD_APP_BASE_URL=http://127.0.0.1:3000
LAUNCHPAD_NOTIFICATION_MAX_ATTEMPTS=5
